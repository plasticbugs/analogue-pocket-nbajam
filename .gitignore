# MAME working state and shadow romset (contains symlinks to the user's ROMs)
.mame/
# The user's romset — never commit ROMs.  Anchored: an unanchored name also
# matches pkg/pocket/Assets/<name>/ (METHODOLOGY section 5.6).
/nbajam/
*.zip
*.rom
*.bin
!pkg/**/*.bin
# Build products
projects/db/
projects/incremental_db/
projects/output_files/
.build/
release/
sim/obj_*/
tmp/
**/__pycache__/
.DS_Store

# Recorded audio: large, and regenerated by the benches and the MAME probes.
# They land in artifacts/audio/ for listening to locally; the comparison
# report next to them is what gets committed.
artifacts/audio/*.wav

# sim/lint.sh builds its waiver file to match the installed Verilator
sim/waivers.vlt
sim/obj_*.log

# raw frame dumps from the benches; the PNG beside each is what is kept
artifacts/**/*.rgb

# Quartus byproducts
projects/c5_pin_model_dump.txt
projects/*.qws

# frozen MAME states: 1.5 MB each and regenerated byte-identically by
# tools/capture_states.sh; the events and pictures beside them are kept
artifacts/states*/state_*.bin
# the probes' raw MAME snapshots; the contact sheet beside them is kept
artifacts/probe*/nbajam/
# MAME's default snapshot directory, when a probe forgets -snapshot_directory
/snap/

# Verilator build directories of the benches
sim/*/obj/
sim/*/obj.log
# raw MAME instruction traces (tens of MB); hist.txt beside them is kept
artifacts/insn/tr_*.txt
sim/*/obj*/
sim/*/obj*.log
artifacts/**/*.wav
